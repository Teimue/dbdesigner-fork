<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest of DBDesigner Fork (Windows).

  It is part of src/AppResources.res (resource type 24, name 1); after a
  change run tools/update-manifest-res.py to put it into the .res file again.

  - Common Controls 6: without it Windows draws the controls in the classic
    style of Windows 95.
  - dpiAware / dpiAwareness "per monitor": the program draws in the pixels
    of the display instead of being magnified (blurred) by Windows. It
    scales itself by the DPI of the primary display at its start (the
    dialogs with the application font, see TDMMain.FitFormLayout) and
    again when a window comes to a display with another DPI (src/UIScale.pas).
  - Windows 10 / 11, 64 bit: the only systems the program is declared and
    tested for. The entry does not keep an older Windows from starting the
    program (it would run it in a compatibility mode); the setup program
    refuses to install there (MinVersion in installer/DBDesignerFork.iss).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="amd64" name="DBDesignerFork" type="win32"/>
  <description>DBDesigner Fork</description>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 (one Id for both) -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
